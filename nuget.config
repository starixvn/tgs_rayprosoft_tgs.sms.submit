<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<!--To inherit the global NuGet package sources remove the <clear/> line below -->
		<clear />
		<add key="raypro-baget" value="https://baget.rpgp.cc/v3/index.json"/>
		<add key="nuget" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="nuget">
			<package pattern="*" />
		</packageSource>
		<packageSource key="raypro-baget">
			<package pattern="Tgs.*" />
			<package pattern="PagingUtility.*" />
		</packageSource>
	</packageSourceMapping>

</configuration>
